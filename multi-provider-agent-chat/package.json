{
  "name": "multi-provider-agent-chat",
  "displayName": "Codenotch Multi-Provider Chat",
  "description": "Local LiteLLM chat with persistent project context",
  "version": "0.1.0",
  "publisher": "netty-linux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/netty-linux/codenotch"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Machine Learning"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "multi-provider-agent.chatView",
          "name": "Multi-Provider Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "multi-provider-agent.newChat",
        "title": "Multi-Provider: New Chat"
      },
      {
        "command": "multi-provider-agent.loadSession",
        "title": "Multi-Provider: Load Session"
      },
      {
        "command": "multi-provider-agent.saveSession",
        "title": "Multi-Provider: Save Session"
      },
      {
        "command": "multi-provider-agent.switchProvider",
        "title": "Multi-Provider: Switch Provider"
      },
      {
        "command": "multi-provider-agent.injectContext",
        "title": "Multi-Provider: Inject Context"
      },
      {
        "command": "multi-provider-agent.setApiKey",
        "title": "Multi-Provider: Set Gateway Key"
      },
      {
        "command": "multi-provider-agent.saveDecision",
        "title": "Multi-Provider: Save Decision"
      }
    ],
    "configuration": {
      "title": "Multi-Provider Agent",
      "properties": {
        "multi-provider-agent.litellmBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4000/v1",
          "scope": "machine"
        },
        "multi-provider-agent.defaultModel": {
          "type": "string",
          "default": "nvidia-nim"
        },
        "multi-provider-agent.contextPath": {
          "type": "string",
          "default": ".context/config.yaml"
        },
        "multi-provider-agent.autoSaveSession": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test test/*.cjs",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
