# Fill only locally. Model strings must include the LiteLLM provider prefix.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
LITELLM_MASTER_KEY=
LITELLM_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=openai/your-nim-model-id
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/your-model-id
OPENAI_API_KEY=
OPENAI_MODEL=openai/your-model-id
GEMINI_API_KEY=
GEMINI_MODEL=gemini/your-model-id
# Optional read-only GitHub token for context. Never added to snapshots.
GITHUB_TOKEN=
# Native monitor, inherited by the Codenotch process:
CODENOTCH_LITELLM_URL=http://127.0.0.1:4000
